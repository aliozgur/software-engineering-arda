{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apprenti locale overlay",
  "description": "Sparse translation beside a canonical curriculum JSON file. Must not change identity keys. Overlay files do not have to satisfy the full task/competency/resource schemas.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "description": "If present, must equal the canonical id or the overlay is ignored."
    },
    "name": { "type": "string" },
    "title": { "type": "string" },
    "description": { "type": "string" },
    "audience": { "type": "string" },
    "philosophy": { "type": "string" },
    "objective": { "type": "string" },
    "whyThisMatters": { "type": "string" },
    "why": { "type": "string" },
    "aiPrinciples": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "level": { "type": "integer" },
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  },
  "additionalProperties": false
}
